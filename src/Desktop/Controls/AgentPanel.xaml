<UserControl x:Class="OneClick.Desktop.Controls.AgentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OneClick.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AgentPanelViewModel}"
             d:DesignHeight="720" d:DesignWidth="920">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,4" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12" Orientation="Vertical">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="Local Agent Execution" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" />
                <Border DockPanel.Dock="Right" Background="#1B5E20" CornerRadius="3" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Local deterministic agents only - no OpenAI/cloud LLM" Foreground="White" FontWeight="SemiBold" />
                </Border>
            </DockPanel>
            <TextBlock Text="This panel lists registered local/offline agents and runs them through shell-wired callbacks. It does not call OpenAI, cloud LLMs, or external AI services."
                       TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#444" />

            <Border BorderBrush="#999" BorderThickness="1" Padding="10" Margin="0,0,0,12" Background="#FFF8F8F8">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Available Agents" DockPanel.Dock="Left" />
                        <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAgentsCommand}" Padding="10,2" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Agents}"
                              SelectedItem="{Binding SelectedAgent, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              MinHeight="90"
                              MaxHeight="180"
                              Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                            <DataGridTextColumn Header="ID" Binding="{Binding Id.Value}" Width="220" />
                            <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="110" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Selected agent" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SelectedAgentName}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Version / kind" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}">
                            <Run Text="{Binding SelectedAgentVersion, Mode=OneWay}" />
                            <Run Text=" / " />
                            <Run Text="{Binding SelectedAgentKind, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Description" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding SelectedAgentDescription}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="#999" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Run Inputs (first-slice local agents)" />
                    <TextBlock Text="Inputs are simple local fields. The shell wires execution to the local agent registry/runner; this control does not create services or perform network calls."
                               TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#444" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project ID" VerticalAlignment="Center" Margin="0,0,8,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProjectIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Fixture path" VerticalAlignment="Center" Margin="0,0,8,6"
                                   Visibility="{Binding ShowsFixturePath, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding FixturePathInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Visibility="{Binding ShowsFixturePath, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Snapshot ID" VerticalAlignment="Center" Margin="0,0,8,6"
                                   Visibility="{Binding ShowsSnapshotInputs, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SnapshotIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6"
                                 Visibility="{Binding ShowsSnapshotInputs, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Snapshot label" VerticalAlignment="Center" Margin="0,0,8,6"
                                   Visibility="{Binding ShowsSnapshotInputs, Converter={StaticResource BoolToVisibility}}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding SnapshotLabelInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                 Visibility="{Binding ShowsSnapshotInputs, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                    Visibility="{Binding ShowsSnapshotInputs, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="Export JSON" IsChecked="{Binding ExportJson}" Margin="0,0,16,0" />
                            <CheckBox Content="Export CSV" IsChecked="{Binding ExportCsv}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Run Selected Agent" Command="{Binding RunAgentCommand}" Padding="12,4" />
                        <TextBlock Text="Runs locally via shell-wired ExecuteAgentAction." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#444" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border BorderBrush="#999" BorderThickness="1" Padding="10" Margin="0,0,0,12" Background="#FFFFFBF0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Last Run Result" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Agent" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastRunAgentName}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Success" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastRunSuccess}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Output summary" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastRunOutputSummary}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Error" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldValue}" Text="{Binding LastRunError}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#999" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Issues" />
                        <ListBox ItemsSource="{Binding Issues}" MinHeight="100" MaxHeight="180" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" BorderBrush="#999" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Warnings" />
                        <ListBox ItemsSource="{Binding Warnings}" MinHeight="100" MaxHeight="180" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" BorderBrush="#999" BorderThickness="1" Padding="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Provenance refs" />
                        <ListBox ItemsSource="{Binding ProvenanceRefs}" MinHeight="100" MaxHeight="180" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border BorderBrush="#999" BorderThickness="1" Padding="8" Background="#FFF">
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Status" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1A1A1A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="#A1260D" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
