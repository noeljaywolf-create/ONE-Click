<UserControl x:Class="OneClick.Desktop.Controls.Geometry.GeometryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="320"
             d:DesignWidth="640"
             MinHeight="120"
             MinWidth="180">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8,6" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left"
                           Text="Geometry plan view (X/Y)"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Line X1="0" Y1="0" X2="14" Y2="0"
                              Stroke="#FF2E6DA4" StrokeThickness="2"
                              VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Known Z" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Line X1="0" Y1="0" X2="14" Y2="0"
                              Stroke="#FFCC7A00" StrokeThickness="2"
                              StrokeDashArray="1 2"
                              VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Provisional Z" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Line X1="0" Y1="0" X2="14" Y2="0"
                              Stroke="#FFC62828" StrokeThickness="2"
                              StrokeDashArray="3 2"
                              VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Unknown Z" VerticalAlignment="Center" ToolTip="Unknown elevation is unresolved; it is not zero." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Line X1="0" Y1="0" X2="14" Y2="0"
                              Stroke="#FF1F8F3A" StrokeThickness="3"
                              VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Selected" VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#FF555555"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           ToolTip="{Binding StatusText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0" Background="White" BorderBrush="#FFE0E0E0" BorderThickness="0">
            <Grid ClipToBounds="True">
                <Canvas x:Name="DrawingCanvas"
                        Background="Transparent"
                        SizeChanged="DrawingCanvas_OnSizeChanged"
                        MouseLeftButtonDown="DrawingCanvas_OnMouseLeftButtonDown" />
                <TextBlock x:Name="EmptyStateText"
                           Text="No route geometry to display."
                           Foreground="#FF777777"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="8,4" Background="#FFF7F7F7" BorderBrush="#FFD0D0D0" BorderThickness="0,1,0,0">
            <TextBlock x:Name="SelectionText"
                       Text="Selected: none"
                       Foreground="#FF444444"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Border>
    </Grid>
</UserControl>
